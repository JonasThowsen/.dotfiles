# Follow the active Omarchy theme. This generated file is updated on theme changes.
config-file = ?"~/.local/state/omarchy/current/theme/ghostty.conf"
gtk-toolbar-style = flat
gtk-titlebar = false

# Font
font-family = Jetbrains Mono
font-size = 14

# Keybinds
## Scroll
keybind = alt+u=scroll_page_up
keybind = alt+d=scroll_page_down
## Search
keybind = alt+f=start_search
## Tabs
keybind = alt+w=close_tab:this
keybind = alt+t=new_tab
## Splits
keybind = alt+v=new_split:right
keybind = alt+s=new_split:down
keybind = alt+h=goto_split:left
keybind = alt+j=goto_split:down
keybind = alt+k=goto_split:up
keybind = alt+l=goto_split:right

# Mouse
mouse-hide-while-typing = true
mouse-scroll-multiplier = precision:0.80,discrete:0.80

# Copy
# Copy selections to both the primary selection and regular system clipboard.
copy-on-select = clipboard
