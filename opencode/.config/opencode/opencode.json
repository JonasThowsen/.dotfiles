{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "tidewave": {
      "type": "remote",
      "url": "http://localhost:4000/tidewave/mcp",
      "enabled": true
    }
  },
  "permission": {
    "*": "allow",
    "bash": {
      "*": "allow",
      "rm *": "ask",
      "git reset *": "ask",
      "git clean *": "ask",
    }
  }
}
